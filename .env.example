OPENAI_API_KEY=
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Optional: point at a local OpenAI-compatible server (e.g. Ollama) instead
# of real OpenAI, for free local development. Leave both blank to use
# OpenAI directly with OPENAI_API_KEY above.
#
# Pick a tool-capable, non-"thinking" model (`ollama show <model>` lists
# capabilities) — thinking models (qwen3.5, gemma4) generate a chain-of-
# thought before every answer, adding 15-20s per call even for trivial
# prompts; that's inherent to the model, not fixable via request params on
# the OpenAI-compatible endpoint. qwen2.5:7b has no such overhead.
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b
